# Discord Bot
CLIENT_TOKEN=your_discord_bot_token_here
PREFIX=_

# MySQL Database
SQL_HOST=localhost
SQL_USER=your_db_user
SQL_PASS=your_db_password
SQL_NAME=your_db_name

# Optional: MySQL connection pool tuning
# SQL_POOL_MAX=10
# SQL_POOL_MIN=0
# SQL_POOL_ACQUIRE=30000
# SQL_POOL_IDLE=10000

# Optional: Cache tuning
# CACHE_MEMORY_TTL=300
# CACHE_CHECK_PERIOD=60

# Environment (DEVELOPMENT or PRODUCTION)
ENVIRONMENT=PRODUCTION

# Health endpoint port (default: 3000)
# HEALTH_PORT=3000
